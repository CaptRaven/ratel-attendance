{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ratel Attendance",
  "version": "0.1.0",
  "identifier": "com.ratel.attendance",
  "build": {
    "frontendDist": "../desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd '/Users/mac/Documents/ratel-attendance /desktop' && npm run dev",
    "beforeBuildCommand": "cd '/Users/mac/Documents/ratel-attendance /desktop' && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ratel Attendance",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}